# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables.
# Sem MP_ACCESS_TOKEN o site roda em MODO DEMO (checkout simulado, nada é cobrado). No demo a ativação NUNCA cria
# contas reais no Obtra/Emptra, mesmo com as credenciais abaixo preenchidas (responde mode "demo").

# URL pública do site (usada nas URLs de retorno do Mercado Pago)
PUBLIC_BASE_URL=http://localhost:3000

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
# Segredo da assinatura x-signature dos Webhooks (painel do MP → Webhooks). Assinatura presente e inválida ⇒ 401.
# Notificações IPN (?topic=payment&id=…) chegam sem assinatura e são aceitas: o pagamento é sempre reconsultado na API.
MP_WEBHOOK_SECRET=

# Segredo para assinar os tokens de acesso pós-pagamento (gere: openssl rand -hex 32)
# Obrigatório em produção (mín. 16 caracteres). Vazio só é aceito no modo demo (que usa um segredo fixo público,
# recusado em produção mesmo se cadastrado aqui).
AQTA_TOKEN_SECRET=

# Notificação da equipe Aqta a cada venda/lead/estorno (qualquer webhook que aceite POST JSON: n8n, Make, Zapier,
# Slack...). Até 3 tentativas por evento. Em produção configure ESTE e/ou o armazenamento abaixo: sem nenhum dos
# dois, os dados de ativação e os leads só existem no log da função (console.error a cada evento).
AQTA_NOTIFY_WEBHOOK=
# WhatsApp comercial/suporte da Aqta (só dígitos, com DDI) — botões de contato; exposto em GET /api/catalog → support
AQTA_WHATSAPP=5521999999999

# Armazenamento durável (Upstash Redis via REST — Vercel → Storage/Marketplace → Upstash "Redis"/KV cria as duas
# variáveis KV_REST_API_*; UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN também são aceitas).
# Usado para: trava "1 pagamento = 1 ativação" entre instâncias (aqta:onboarding:<paymentId>), revogação por
# estorno/chargeback (aqta:revoked:<paymentId>), deduplicação de avisos e cópia de todos os eventos (aqta:events).
# IMPORTANTE: em produção SEM este armazenamento o provisionamento automático (Obtra/Emptra) fica DESLIGADO e toda
# ativação vira manual pela equipe — sem a trava, o mesmo pagamento poderia criar várias contas.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Provisionamento automático do Obtra (Supabase do Obtra). Vazio = provisionamento manual pela equipe.
# Só funciona em produção (MP_ACCESS_TOKEN) e com o armazenamento durável acima configurado.
OBTRA_SUPABASE_URL=
OBTRA_SUPABASE_SERVICE_KEY=
OBTRA_APP_URL=https://obtra.vercel.app

# Provisionamento automático do Emptra (API do Emptra, login de admin). Vazio = provisionamento manual.
# Só funciona em produção (MP_ACCESS_TOKEN) e com o armazenamento durável acima configurado.
EMPTRA_API_URL=
EMPTRA_ADMIN_EMAIL=
EMPTRA_ADMIN_PASSWORD=
EMPTRA_APP_URL=https://emptra.srv1848886.hstgr.cloud
